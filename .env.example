# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Set this in production to be able to restart without regenerating the secret
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
# Comma-separated list of trusted reverse-proxy IPs/CIDRs for rate-limit
# client detection behind a load balancer. Leave empty when running directly.
TRUST_PROXY=

# ── Payments ─────────────────────────────────────────────────────────────────
# 'demo'      → test-mode cards only (4242 4242 4242 4242 success, 4000…0002 decline)
# 'stripe'    → reserved slot — flip when the real gateway integration is live
PAYMENT_PROVIDER=demo

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@confetticlub.shop
ADMIN_PASSWORD=ChangeMe!2026

# ── Rate limiting ───────────────────────────────────────────────────────────
# BASE limit is 2000 req / 15 min per IP; the limiter multiplies it by this value.
# 1 = default. Raise to 50 for a 200-shopper load test (each shopper shares one IP).
RATE_MULTIPLIER=1

# ── Storefront (optional) ────────────────────────────────────────────────────
SITE_NAME=Confetti Club
